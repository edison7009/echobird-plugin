{
  "$schema": "https://raw.githubusercontent.com/edison7009/echobird-plugin/main/schemas/plugin-manifest.schema.json",
  "name": "reversi",
  "publisher": "echobird",
  "version": "1.0.0",
  "displayName": "黑白棋 · Reversi",
  "description": "与选定的 AI 模型对弈。Play Reversi with your selected AI model.",
  "license": "MIT",
  "repository": "https://github.com/edison7009/echobird-plugin",
  "icon": "ui/icon.svg",
  "echobird": {
    "manifestVersion": 1,
    "apiVersion": "0.1-draft",
    "platforms": [
      "windows",
      "macos",
      "linux"
    ],
    "permissions": [
      "model.request"
    ],
    "contributes": {
      "pages": [
        {
          "id": "game",
          "title": "黑白棋 · Reversi",
          "entry": "ui/index.html"
        }
      ]
    }
  }
}
