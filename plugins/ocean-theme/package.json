{
  "name": "ocean-theme",
  "publisher": "echobird",
  "version": "0.1.0",
  "displayName": "Ocean Theme",
  "description": "A light and dark ocean palette for EchoBird.",
  "category": "appearance",
  "license": "MIT",
  "repository": "https://github.com/edison7009/echobird-plugin",
