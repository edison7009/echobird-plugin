{
  "$schema": "https://raw.githubusercontent.com/edison7009/echobird-plugin/main/schemas/plugin-manifest.schema.json",
  "name": "claude-code-accounts",
  "publisher": "echobird-community",
  "version": "0.1.0-preview.1",
  "displayName": "Claude Code",
  "description": "Claude Code 账号登录、切换及已有账号能力。Account capabilities for Claude Code.",
  "license": "MIT",
  "repository": "https://github.com/edison7009/echobird-plugin",
  "icon": "icon.svg",
  "category": "account",
  "echobird": {
    "manifestVersion": 1,
    "apiVersion": "0.1-draft",
    "platforms": [
      "windows"
    ],
    "permissions": [
      "account.code"
    ],
    "worker": {
      "runtime": "native",
      "entry": "bin/echobird-account-engine.exe"
    },
    "contributes": {
      "pages": [],
      "providers": [
        {
          "id": "claudecode",
          "title": "Claude Code",
          "applications": [
            "claudecode"
          ],
          "searchTerms": [
            "Claude Code",
            "claudecode"
          ],
          "operations": [
            "accounts",
            "login.start",
            "login.complete",
            "login.cancel",
            "account.refresh",
            "account.apply",
            "account.remove",
            "models",
            "proxy",
            "voice"
          ]
        }
      ]
    }
  }
}
