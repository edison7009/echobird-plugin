{
  "$schema": "https://raw.githubusercontent.com/edison7009/echobird-plugin/main/schemas/plugin-manifest.schema.json",
  "name": "claude-desktop-accounts",
  "publisher": "echobird-community",
  "version": "0.1.0-preview.2",
  "displayName": "Claude Desktop",
  "description": "Claude Desktop 账号登录、切换及已有账号能力。Account capabilities for Claude Desktop.",
  "license": "MIT",
  "repository": "https://github.com/edison7009/echobird-plugin",
  "icon": "icon.svg",
  "category": "account",
  "echobird": {
    "manifestVersion": 1,
    "apiVersion": "0.1-draft",
    "platforms": [
      "windows"
    ],
    "permissions": [
      "account.code"
    ],
    "worker": {
      "runtime": "native",
      "entry": "bin/echobird-account-engine.exe"
    },
    "contributes": {
      "pages": [],
      "providers": [
        {
          "id": "claudedesktop",
          "title": "Claude Desktop",
          "applications": [
            "claudedesktop"
          ],
          "searchTerms": [
            "Claude Desktop",
            "claudedesktop"
          ],
          "operations": [
            "accounts",
            "login.start",
            "login.poll",
            "login.cancel",
            "account.refresh",
            "account.apply",
            "account.remove",
            "history.merge"
          ]
        }
      ]
    }
  }
}
