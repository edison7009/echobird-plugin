{
  "$schema": "https://raw.githubusercontent.com/edison7009/echobird-plugin/main/schemas/plugin-manifest.schema.json",
  "name": "commandcode",
  "publisher": "echobird-community",
  "version": "0.1.0-preview.5",
  "displayName": "Command Code",
  "description": "Command Code 桌面端和 CLI 的安装、启动、模型切换、账号切换和智能接入。Install, launch and switch models or accounts for Command Code and its CLI.",
  "license": "MIT",
  "repository": "https://github.com/edison7009/echobird-plugin",
  "icon": "icon.svg",
  "category": "application",
  "categories": [
    "application",
    "account"
  ],
  "tools": [
    {
      "id": "commandcode",
      "directory": "tools/commandcode"
    },
    {
      "id": "commandcodecli",
      "directory": "tools/commandcodecli"
    }
  ],
  "echobird": {
    "manifestVersion": 1,
    "apiVersion": "0.1-draft",
    "platforms": [
      "windows",
      "macos",
      "linux"
    ],
    "permissions": [
      "account.code"
    ],
    "worker": {
      "runtime": "node",
      "entry": "service.mjs"
    },
    "contributes": {
      "pages": [],
      "providers": [
        {
          "id": "commandcode",
          "title": "Command Code",
          "applications": [
            "commandcode",
            "commandcodecli"
          ],
          "searchTerms": [
            "Command Code",
            "commandcode",
            "cmd",
            "Command Code CLI"
          ],
          "operations": [
            "accounts",
            "login.start",
            "login.poll",
            "login.cancel",
            "account.refresh",
            "account.apply",
            "account.remove",
            "models",
            "proxy"
          ]
        }
      ]
    }
  }
}
