{
  "name": "Command Code CLI",
  "category": "CLI Code",
  "apiProtocol": ["openai", "anthropic"],
  "docs": "https://commandcode.ai/docs",
  "website": "https://commandcode.ai/",
  "command": "commandcode",
  "startCommand": "commandcode",
  "envVar": "COMMAND_CODE_PATH",
  "configDir": "~/.commandcode",
  "configFile": "~/.commandcode/settings.json",
  "requireConfigFile": false,
  "paths": {
    "win32": [
      "%APPDATA%\\npm\\commandcode.cmd",
      "%LOCALAPPDATA%\\pnpm\\commandcode.cmd",
      "%USERPROFILE%\\.npm-global\\commandcode.cmd"
    ],
    "darwin": [
      "/opt/homebrew/bin/commandcode",
      "/usr/local/bin/commandcode",
      "~/.npm-global/bin/commandcode",
      "~/Library/pnpm/commandcode"
    ],
    "linux": [
      "/usr/local/bin/commandcode",
      "~/.npm-global/bin/commandcode",
      "~/.local/share/pnpm/commandcode"
    ]
  }
}
