{
  "$schema": "https://raw.githubusercontent.com/edison7009/echobird-plugin/main/schemas/plugin-manifest.schema.json",
  "name": "trae-accounts",
  "publisher": "echobird-community",
  "version": "0.1.0-preview.1",
  "displayName": "Trae",
  "description": "Trae 账号登录、切换、智能接入和语音接入。Account capabilities for Trae.",
  "license": "MIT",
  "repository": "https://github.com/edison7009/echobird-plugin",
  "icon": "icon.svg",
  "category": "account",
  "echobird": {
    "manifestVersion": 1,
    "apiVersion": "0.1-draft",
    "platforms": [
      "windows"
    ],
    "permissions": [
      "account.code"
    ],
    "worker": {
      "runtime": "native",
      "entry": "bin/echobird-account-engine.exe"
    },
    "contributes": {
      "pages": [],
      "providers": [
        {
          "id": "trae",
          "title": "Trae",
          "applications": [
            "trae"
          ],
          "searchTerms": [
            "Trae",
            "trae"
          ],
          "operations": [
            "accounts",
            "login.start",
            "login.poll",
            "login.cancel",
            "account.refresh",
            "account.claim",
            "account.apply",
            "account.remove",
            "models",
            "proxy",
            "voice"
          ]
        }
      ]
    }
  }
}
