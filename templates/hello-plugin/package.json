{
  "$schema": "https://raw.githubusercontent.com/edison7009/echobird-plugin/main/schemas/plugin-manifest.schema.json",
  "name": "hello-plugin",
  "publisher": "example",
  "version": "0.1.0",
  "displayName": "Hello Plugin",
  "description": "A minimal local page for an EchoBird plugin.",
  "license": "MIT",
  "repository": "https://github.com/example/hello-plugin",
  "private": true,
  "echobird": {
    "manifestVersion": 1,
    "apiVersion": "0.1-draft",
    "platforms": [
      "windows",
      "macos",
      "linux"
    ],
    "permissions": [],
    "contributes": {
      "pages": [
        {
          "id": "hello",
          "title": "Hello Plugin",
          "entry": "ui/index.html"
        }
      ]
    }
  }
}
