{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/edison7009/echobird-plugin/main/schemas/plugin-manifest.schema.json",
  "title": "EchoBird plugin manifest draft 1",
  "type": "object",
  "required": [
    "name",
    "publisher",
    "version",
    "displayName",
    "description",
    "license",
    "repository",
    "echobird"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "$ref": "#/$defs/identifier"
    },
    "publisher": {
      "$ref": "#/$defs/identifier"
    },
    "version": {
      "type": "string",
      "format": "semver"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "repository": {
      "type": "string",
      "format": "public-https"
    },
    "private": {
      "type": "boolean"
    },
    "icon": {
      "type": "string",
      "format": "relative-asset",
      "maxLength": 240
    },
    "category": {
      "type": "string",
      "enum": ["application", "account", "appearance", "feature", "other"]
    },
    "echobird": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestVersion",
        "apiVersion",
        "platforms",
        "permissions",
        "contributes"
      ],
      "properties": {
        "manifestVersion": {
          "const": 1
        },
        "apiVersion": {
          "const": "0.1-draft"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": ["windows", "macos", "linux"]
          }
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "model.request",
              "clipboard.write",
              "account.code",
              "extension.background",
              "configuration",
              "storage",
              "commands",
              "events",
              "text.process"
            ]
          }
        },
        "contributes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pages"],
          "properties": {
            "pages": {
              "type": "array",
              "minItems": 0,
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "title", "entry"],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/identifier"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "entry": {
                    "type": "string",
                    "format": "relative-html"
                  }
                }
              }
            },
            "providers": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "title", "applications"],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/identifier"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "applications": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "uniqueItems": true,
                    "items": {
                      "$ref": "#/$defs/identifier"
                    }
                  },
                  "pageId": {
                    "$ref": "#/$defs/identifier"
                  },
                  "operations": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "accounts",
                        "login.start",
                        "login.complete",
                        "login.poll",
                        "login.cancel",
                        "account.refresh",
                        "account.claim",
                        "account.apply",
                        "account.remove",
                        "models",
                        "proxy",
                        "voice",
                        "history.merge"
                      ]
                    }
                  },
                  "searchTerms": {
                    "type": "array",
                    "maxItems": 32,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    }
                  }
                }
              }
            },
            "themes": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "title", "light", "dark"],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/identifier"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "light": {
                    "type": "object",
                    "additionalProperties": false,
                    "minProperties": 1,
                    "properties": {
                      "background": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "surface": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "elevated": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "input": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "border": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "text": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "textSecondary": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "textMuted": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "accent": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "accentSecondary": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      }
                    }
                  },
                  "dark": {
                    "type": "object",
                    "additionalProperties": false,
                    "minProperties": 1,
                    "properties": {
                      "background": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "surface": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "elevated": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "input": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "border": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "text": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "textSecondary": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "textMuted": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "accent": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "accentSecondary": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      }
                    }
                  }
                }
              }
            },
            "configuration": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "title", "type", "default"],
                "properties": {
                  "key": {
                    "$ref": "#/$defs/identifier"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "type": {
                    "enum": ["boolean", "number", "string"]
                  },
                  "default": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "string",
                        "maxLength": 4096
                      }
                    ]
                  },
                  "options": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "string",
                          "maxLength": 4096
                        }
                      ]
                    }
                  }
                }
              }
            },
            "commands": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "title"],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/identifier"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "pageId": {
                    "$ref": "#/$defs/identifier"
                  }
                }
              }
            },
            "textProcessors": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "title", "stage"],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/identifier"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "stage": {
                    "enum": ["voice.transcribed", "voice.output"]
                  }
                }
              }
            }
          }
        },
        "worker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entry"],
          "properties": {
            "entry": {
              "type": "string",
              "format": "relative-asset"
            },
            "runtime": {
              "enum": ["node", "native"]
            }
          }
        },
        "background": {
          "type": "string",
          "format": "relative-script"
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    }
  }
}
