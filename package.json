{
  "name": "echobird-plugin-registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plugin specifications, templates and registry for EchoBird.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "node scripts/validate.mjs",
    "build:index": "node scripts/build-index.mjs",
    "pack:reversi": "node scripts/package-plugin.mjs plugins/reversi",
    "index:check": "node scripts/build-index.mjs --check",
    "test": "node --test",
    "check": "npm run format:check && npm run validate && npm run index:check && npm test"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "fflate": "0.8.3",
    "prettier": "3.9.10",
    "semver": "7.8.5",
    "yaml": "2.9.1"
  }
}
